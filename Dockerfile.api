FROM node:20-bookworm-slim

RUN rm -f /etc/apt/sources.list.d/* && \
    printf '%s\n' \
      'deb http://mirror.yandex.ru/debian bookworm main' \
      'deb http://mirror.yandex.ru/debian bookworm-updates main' \
      > /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl jq unzip && \
    rm -rf /var/lib/apt/lists/*

RUN curl -L https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip -o xray.zip && \
    unzip xray.zip && \
    mv xray /usr/local/bin/ && \
    chmod +x /usr/local/bin/xray && \
    rm -f xray.zip geoip.dat geosite.dat

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

RUN chmod +x /app/setup-proxy.sh

EXPOSE 3001

CMD ["/app/setup-proxy.sh"]
